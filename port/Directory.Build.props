<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0168;CS0219;CS0414;CS0649;CS0169;CS1591;CS8981;SYSLIB0011;SYSLIB0012;FS0064;FS0044;FS3370;FS0040;FS3560;NU1701</NoWarn>
    <Src>$(MSBuildThisFileDirectory)../vcc/</Src>
    <Libs>$(MSBuildThisFileDirectory)../vcc/</Libs>
    <BoogieLibs>$(MSBuildThisFileDirectory).libs/Boogie/</BoogieLibs>
    <!-- Boogie patched to call its prover in-process (WebAssembly build) -->
    <BoogieInprocLibs>$(MSBuildThisFileDirectory).libs/Boogie-inproc/</BoogieInprocLibs>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
